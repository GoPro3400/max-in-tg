# This file is the template for a real deployment, so it defaults to
# production. In development the logger switches to human-readable pretty
# output; production keeps the structured JSON that tooling can parse.
NODE_ENV=production
LOG_LEVEL=info

# Telegram
# The ONLY value you have to provide. Create a bot in @BotFather (/newbot) and
# paste the token here (scripts/install.sh asks for it and writes it for you).
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional — discovered at runtime, leave empty.
# Your Telegram user id. When empty the bridge prints a one-time pairing code
# into the container log on startup (docker compose logs | grep pairingCode);
# sending "/pair <code>" to the bot in a PRIVATE chat claims ownership. Until
# that happens the bot answers nothing else, from anyone. The code is 8 random
# bytes in base64url, and after 5 wrong attempts a Telegram account is locked
# out of /pair for 10 minutes (the code stays the same): an unclaimed bot
# accepts /pair from anyone, bot usernames are globally searchable, and
# winning that guess would hand over the MAX login QR. Once claimed, the id is
# stored in the bridge's own database (settings table), so restarts and
# rebuilds never ask again.
# Set it explicitly only if you want to pin the owner from the start — an
# environment variable always wins over what was discovered earlier.
TELEGRAM_OWNER_ID=

# Optional — discovered at runtime, leave empty.
# Recommended setup: create a private Telegram supergroup, enable Topics, and add
# the bot as admin (send messages/media, manage topics, pin messages). Adding the
# bot IS the configuration step — it detects the group itself and remembers the id
# in the settings table, exactly like the owner above. If Topics are off or the
# bot is not an admin, it says so in the group and does not adopt it. Adding the
# bot BEFORE /pair works too: the group is remembered and adopted right after
# pairing, once the bot has verified that the new owner is a member of it. To
# re-point the bridge at another group, send /relay inside that group.
# With no relay group, everything lands in the owner's private chat (no topics).
TELEGRAM_RELAY_CHAT_ID=
TELEGRAM_USE_TOPICS=true
TELEGRAM_AUTO_CREATE_TOPICS=true

# Max Web
MAX_WEB_URL=https://web.max.ru/
MAX_USER_DATA_DIR=./data/chrome-profile
# Keep false in production: the Docker image runs Chromium under a virtual X
# display (Xvfb, see scripts/start.sh) so it renders like a real browser —
# headless Chromium does not reliably paint MAX's animated sticker canvas.
MAX_HEADLESS=false
MAX_PROTOCOL_TIMEOUT_MS=180000
# Show MAX's animated emoji (animoji) as the still emoji picture MAX draws
# while one loads. That picture names its emoji; the animation does not — it
# is how reactions are read and picked, and how an animoji in a message
# reaches Telegram as its emoji. Stickers stay animated. Also saves CPU.
MAX_STATIC_ANIMOJI=true
# Chromium's DevTools port for scripts/devtools-repl.js — reachable only
# inside the container, never published. 0: any free port.
# MAX_REMOTE_DEBUGGING_PORT=9222

# Runtime paths
SQLITE_PATH=./data/max-in-tg.sqlite
MEDIA_DIR=./tmp/media
DIAGNOSTIC_DIR=./logs/diagnostics
DIAGNOSTIC_FILES_LIMIT=4
DIAGNOSTIC_RETENTION_FILES=80
# Diagnostic HTML dumps are full captures of the live MAX page and therefore
# contain private conversation text. Redacted by default: the DOM structure is
# kept, message text and personal labels become length markers. Set to false
# only for a short, deliberate debugging session. SVG contents are stripped from
# every dump regardless of this setting, and no screenshot is taken at all while
# the MAX sign-in screen is showing — MAX draws the login QR as inline SVG, and
# /diagnostics uploads dumps into whatever chat asked for them.
DIAGNOSTIC_REDACT_TEXT=true
# On the FIRST run (empty database) the bridge marks everything MAX already
# shows as seen, so your existing correspondence is not delivered to Telegram
# as if it just arrived. On later starts it does not do this, so messages that
# came in while the bridge was down are still delivered.
STARTUP_PRIME_EXISTING_MESSAGES=true
# 0 = every chat (recommended). A positive value caps how many chats are
# primed — the chats beyond it WILL dump their visible history into Telegram
# on a first run, one message at a time. Only set it if you want that.
STARTUP_PRIME_CHATS_LIMIT=0
POLL_INTERVAL_MS=650
HISTORY_LIMIT=50
MAX_CHATS_PER_POLL=4
MAX_POLL_FAILURES_BEFORE_RESTART=5
# Chromium's memory used to grow while MAX Web stayed open (~2 GB in ~3 hours,
# after which sends into MAX failed) and was kept in check by a host cron job
# restarting the container. The causes are fixed now, and the bridge looks
# after the browser by itself — no cron job is needed. Between two poll
# cycles, never during a send or a QR sign-in:
#   * above MAX_PAGE_RELOAD_MEMORY_MB the MAX tab is reloaded (a few seconds);
#   * above MAX_BROWSER_MEMORY_LIMIT_MB, or after MAX_BROWSER_RECYCLE_MINUTES,
#     Chromium is relaunched (15-30 seconds).
# Both keep the MAX session and the Telegram bot online, and nothing is lost:
# Telegram messages sent meanwhile wait, and MAX messages are picked up after.
# Memory is the whole Chromium process tree (PSS). 0 disables that trigger.
MAX_PAGE_RELOAD_MEMORY_MB=900
MAX_BROWSER_MEMORY_LIMIT_MB=1300
MAX_BROWSER_RECYCLE_MINUTES=360
# How many times a single MAX->Telegram message is retried before it is
# marked as seen (given up) and a failure notice is posted to Telegram.
MAX_DELIVERY_ATTEMPTS=5
# Mirror reactions both ways. A reaction someone puts on a message in MAX
# shows in Telegram as the bot's reaction on that message (a bot may set one,
# from Telegram's list — the nearest one stands in, e.g. 😂 as 🤣); your own
# reaction on a bridged message in Telegram is set as yours in MAX.
SYNC_REACTIONS=true

# Max Web selectors. Leave them commented out: the built-in defaults in
# src/config.js are the ones kept in step with the live MAX DOM, and any line
# set here OVERRIDES them. (This template used to set the old values, so every
# fresh install pinned message selectors that no longer match MAX's bubbles
# and MAX->Telegram delivered nothing.) Uncomment a line only to try a fix for
# a DOM change before an update ships; the values below are the defaults.
# MAX_SELECTORS_CHAT_LIST=aside[aria-labelledby="aside-header-title"] .scrollListContent
# MAX_SELECTORS_CHAT_ITEM=aside[aria-labelledby="aside-header-title"] .item[data-index]
# MAX_SELECTORS_CHAT_TITLE=h3.title span.name span.text
# MAX_SELECTORS_CHAT_UNREAD=.indicator .badgeIcon, .badgeIcon[aria-label*="new"]
# MAX_SELECTORS_ACTIVE_CHAT_TITLE=[id="main-header-title"]
# MAX_SELECTORS_MESSAGE_LIST=main .scrollListContent, main .content
# MAX_SELECTORS_MESSAGE_ITEM=main [data-bubbles-variant] > .bubble, main .bubble
# MAX_SELECTORS_MESSAGE_TEXT=.text, [data-lexical-text]
# MAX_SELECTORS_MESSAGE_AUTHOR=.author, .sender, .bubbleAuthor
# MAX_SELECTORS_MESSAGE_TIME=.time[aria-label], time
# A bubble's own meta line (its time, "ред."), and the sender's name above a
# group bubble (its .name is read). Both are left out of the message text.
# MAX_SELECTORS_MESSAGE_META_TIME=.bubbleContent > .meta
# MAX_SELECTORS_MESSAGE_SENDER=.bubbleContent > .header
# MAX_SELECTORS_MESSAGE_IMAGE=img, canvas
# MAX_SELECTORS_MESSAGE_AUDIO=audio, [class*="voice"], [data-testid*="voice"]
# MAX_SELECTORS_MESSAGE_VIDEO=video, source[type="video"]
# MAX_SELECTORS_MESSAGE_DOCUMENT=a[href][download],a[href*="/file"],a[href*="/download"]
# A file card in a bubble (name in .title, size in .info), and a link's
# preview card under the text.
# MAX_SELECTORS_MESSAGE_FILE_CARD=.bubbleContent > .attaches > button.container
# MAX_SELECTORS_MESSAGE_LINK_PREVIEW=.bubbleContent > .share
# MAX_SELECTORS_COMPOSER=[data-testid="composer"] [contenteditable][role="textbox"], [data-lexical-editor="true"]
# MAX_SELECTORS_ATTACH_INPUT=input[type="file"]
# Attach flow: paperclip opens an actions menu; the file input is only wired up
# after picking a menu item. See docs/MEDIA_PIPELINE.md.
# MAX_SELECTORS_ATTACH_BUTTON=button[aria-label="Upload file"]
# MAX_SELECTORS_ATTACH_MENU_MEDIA=button[role="menuitem"][aria-label*="Photo"]
# MAX_SELECTORS_ATTACH_MENU_FILE=button[role="menuitem"][aria-label*="File"]
# MAX_SELECTORS_SEND_BUTTON=[data-testid="composer"] button[aria-label="Send message"], button[aria-label="Send message"]
# Attachment-staged indicator and outgoing-bubble counter (delivery verification).
# MAX_SELECTORS_ATTACH_PREVIEW=[data-testid="composer"] [class*="attach"], [data-testid="composer"] [class*="preview"], [data-testid="composer"] img, [data-testid="composer"] video
# MAX_SELECTORS_OUTGOING_BUBBLE=[data-bubbles-variant="outgoing"]
# MAX_SELECTORS_TYPING=[data-testid="typing-indicator"]
# Telegram->MAX replies: hovering a bubble reveals a one-click Reply button;
# clicking it puts the composer into reply mode, shown by a banner with a close
# ("x") button. See docs/MEDIA_PIPELINE.md.
# MAX_SELECTORS_MESSAGE_REPLY_BUTTON=button[aria-label="Reply"]
# MAX_SELECTORS_COMPOSER_REPLY_ACTIVE=[data-testid="composer"] button.close
# Reactions: a bubble's chips (.reaction, ours marked .reaction--active) sit
# in a .reactions container inside or right after it; the message menu (right
# click, else the "Message actions" button) lists the reactions to pick from.
# MAX_SELECTORS_MESSAGE_REACTIONS=.reactions
# MAX_SELECTORS_MESSAGE_REACTION_CHIP=.reaction
# MAX_SELECTORS_MESSAGE_ACTIONS_BUTTON=button[aria-label="Message actions"], button[aria-label="Действия с сообщением"]
# MAX_SELECTORS_MESSAGE_MENU=[role="menu"]
# MAX_SELECTORS_REACTION_OPTION=[role="menu"] .reaction, .menuContainer .reaction
# MAX_SELECTORS_REACTION_EXPAND=[role="menu"] .extendBtn, .menuContainer .extendBtn
